// use prisma-8

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  author     User?    @relation(fields: [authorId], references: [id])
  authorId   Int?
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  legacyAuthor String @map("author") @default("Anonymous")
}




model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  password  String
  posts Post[]
}